# ====================================================================
# MISSALPHA AI LAB - ENVIRONMENT VARIABLES
# Copy this file to .env.local and fill in your actual credentials
# ====================================================================

# 1. APP CONFIGURATION
NEXT_PUBLIC_APP_URL=http://localhost:3000

# 2. SUPABASE CONFIGURATION
# Found in: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# Server-only key with elevated bypass rights (never expose to client)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key-here

# 3. RAZORPAY PAYMENT GATEWAY
# Found in: Razorpay Dashboard -> Settings -> API Keys
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_YourTestKeyIdHere
RAZORPAY_KEY_SECRET=YourRazorpaySecretKeyHere
# Found in: Razorpay Dashboard -> Settings -> Webhooks
RAZORPAY_WEBHOOK_SECRET=YourWebhookSecretSecretHere

# 4. ADMIN USER ACCESS CONTROL
# Comma-separated list of emails with full administrative dashboard access
ADMIN_EMAILS=admin@missalpha.ai,founder@missalpha.ai
